# ── Required: Database (Supabase PostgreSQL) ──────────────────────
# Use the connection pooler URL (port 6543) for async operations
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxx.supabase.co:6543/postgres
# Use the direct URL (port 5432) for Alembic migrations
DIRECT_URL=postgresql+psycopg2://postgres:password@db.xxxxx.supabase.co:5432/postgres

# ── Required: Supabase ────────────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Required: JWT ─────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET=your-strong-random-jwt-secret-at-least-32-chars

# ── Optional: AI Providers ────────────────────────────────────────
# OpenRouter is the primary AI provider for note generation
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_LLM_MODEL=google/gemini-2.5-flash

# Optional providers (for future use)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# ── Optional: Application Settings ────────────────────────────────
DEBUG=false
PRODUCTION_DOMAIN=https://your-frontend-domain.vercel.app
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ── Optional: Whisper (Speech-to-Text) ────────────────────────────
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=en  # Uncomment to set a default language

# ── Optional: YouTube Processing ──────────────────────────────────
# Override paths if not in system PATH
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
#
# FFmpeg is auto-resolved in this order: FFMPEG_PATH (if set to a real
# path) -> system PATH -> the static binary bundled with imageio-ffmpeg.
# No system install is required. ffprobe is no longer used (audio duration
# is read from the WAV header via the stdlib wave module).

# ── Optional: YouTube extraction hardening (server-side only) ─────
# No user setup required – these are operator-level knobs. Users never
# log into browsers, export cookies, or configure anything themselves.
#
# Player-client fallback chain tried in order. Mobile/TV clients bypass
# YouTube's "Sign in to confirm you're not a bot" check far more often
# than the default `web` client on flagged datacenter IPs.
# YTDLP_PLAYER_CLIENTS=android,web_safari,ios,tv,mweb,web
#
# Optional egress proxy to escape bot-flagged datacenter IPs.
# YTDLP_PROXY=http://user:pass@residential-proxy:port
#
# Optional OPERATOR-provided Netscape cookies.txt for edge cases that
# still need a signed-in session. NEVER point this at user cookies.
# YTDLP_COOKIES_FILE=/etc/noteflow/youtube_cookies.txt

# ── Optional: Storage ─────────────────────────────────────────────
STORAGE_BUCKET=noteflow-ai
